@model IEnumerable<Tag>
@{
    ViewData["Title"] = "タグ一覧";
    ViewData["ActiveNav"] = "Tag";
    var triviaCounts = ViewBag.TriviaCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="toolbar">
    <a asp-action="Create"><button class="btn primary">＋ 新規登録</button></a>
</div>

<table>
    <thead>
        <tr>
            <th>タグ名</th>
            <th>雑学数</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tag in Model)
        {
            <tr>
                <td>
                    <span style="display:inline-block;background:#FAEEDA;color:#633806;font-size:10px;padding:2px 8px;border-radius:99px;">
                        @tag.TagName
                    </span>
                </td>
                <td>
                    <span style="display:inline-block;background:#f7f7f5;color:#666;font-size:10px;padding:1px 6px;border-radius:3px;">
                        @(triviaCounts.ContainsKey(tag.Id) ? triviaCounts[tag.Id] : 0)件
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@tag.Id"><button class="act">編集</button></a>
                    <form asp-action="Delete" asp-route-id="@tag.Id" method="post" style="display:inline;"
                          onsubmit="return confirm('削除しますか？このタグが付いた雑学からも削除されます。');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="act" style="color:#c00;">削除</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="3" style="text-align:center;color:#999;padding:20px;">タグが登録されていません。</td></tr>
        }
    </tbody>
</table>
